<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ title or site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {# Favicon — this is what Google shows beside the domain in search results.
     It needs a stable URL, a square image and a size that is a multiple of 48. #}
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/icons/icon-48.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">

  <meta name="robots" content="{{ robots or 'index, follow' }}">
  <meta name="theme-color" content="#0E0F10">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
  <meta property="og:locale" content="en_GB">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.name }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=Raleway:wght@300;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/precision.css' | bust }}">
  {% if extraCss %}<link rel="stylesheet" href="{{ ('/assets/css/' + extraCss) | bust }}">{% endif %}
{% if site.googleAdsId or site.gaId %}
  {# Google tag — loaded once, feeds both Google Ads and Analytics #}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.googleAdsId or site.gaId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    {% if site.googleAdsId %}gtag('config', '{{ site.googleAdsId }}');{% endif %}
    {% if site.gaId %}gtag('config', '{{ site.gaId }}');{% endif %}
  </script>
  {% if site.googleAdsId and adsConversionLabel %}
  {# Conversion event — only on a page that sets adsConversionLabel (the thank-you page) #}
  <script>
    gtag('event', 'conversion', {'send_to': '{{ site.googleAdsId }}/{{ adsConversionLabel }}'});
  </script>
  {% endif %}
{% endif %}
  <script type="application/ld+json">{{ site.structuredData | dump | safe }}</script>
</head>
<body class="{{ bodyClass }}">
  {% if not hideChrome %}
    {% include "partials/nav.njk" %}
    {% include "partials/menu.njk" %}
  {% endif %}

  {{ content | safe }}

  {% if not hideChrome and not hideFooter %}
    {% include "partials/footer.njk" %}
  {% endif %}

  {% if not hideChrome and not hideStickyCta %}
    {% include "partials/sticky-cta.njk" %}
  {% endif %}

  <script src="{{ '/assets/js/precision.js' | bust }}"></script>
  {% if extraJs %}<script src="{{ ('/assets/js/' + extraJs) | bust }}"></script>{% endif %}
</body>
</html>
