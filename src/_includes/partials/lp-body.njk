{# Facebook landing page — everything below the hero. Shared by /free-quote/ and /free-quote-b/.
   One job: get a quote request or a call. No nav, no links off the page except the phone. #}

  <section class="lp-proof" aria-label="Why Precision">
    <div class="lp-wrap lp-proof-row">
      <div class="lp-pf"><b>4 generations</b><span>Surfacing Norfolk since the 1960s</span></div>
      <div class="lp-pf"><b>Our own team</b><span>Laid in-house, never subcontracted</span></div>
      <div class="lp-pf"><b>Free visit</b><span>Measured up, with a written quote</span></div>
      <div class="lp-pf"><b>Norfolk only</b><span>Norwich, the coast and everywhere between</span></div>
    </div>
  </section>

  <section class="lp-sec lp-ba" aria-labelledby="ba-h">
    <div class="lp-wrap">
      <span class="lp-eyebrow">Before &amp; after</span>
      <h2 id="ba-h" class="lp-h2">Same drive. <em>Transformed.</em></h2>
      <p class="lp-lede">A tired driveway in Sheringham, dug out and relaid in tarmac by our own team.</p>
      <div class="lp-pair">
        <figure><img src="/assets/images/tarmac/projects/sheringham-grey/sheringham-grey-tarmac-driveway-before.webp" alt="Sheringham driveway before: worn, patchy surface" loading="lazy" decoding="async"><span class="lp-tag">Before</span></figure>
        <figure class="after"><img src="/assets/images/tarmac/projects/sheringham-grey/sheringham-grey-tarmac-driveway-finished.webp" alt="Sheringham driveway after: new grey tarmac" loading="lazy" decoding="async"><span class="lp-tag">After</span></figure>
      </div>
    </div>
  </section>

  <section class="lp-sec lp-work" aria-labelledby="work-h">
    <div class="lp-wrap">
      <span class="lp-eyebrow">Recent driveways</span>
      <h2 id="work-h" class="lp-h2">Laid across <em>Norfolk.</em></h2>
    </div>
    <div class="lp-strip" tabindex="0" aria-label="Recent driveways, scroll sideways">
      {% for w in [
        ["resin/projects/wells-silver-grey/wells-silver-grey-resin-driveway-finished.webp", "Resin bound", "Wells-next-the-Sea"],
        ["tar-and-chip/projects/the-old-hall/the-old-hall-tar-and-chip-driveway-finished.webp", "Tar & chip", "The Old Hall"],
        ["block-paving/projects/st-faiths/st-faiths-block-paving-driveway-finished.webp", "Block paving", "St Faiths"],
        ["resin/projects/holt-golden-harvest/holt-golden-harvest-resin-driveway-finished.webp", "Resin bound", "Holt"],
        ["gravel/projects/norwich-block-edged/norwich-block-edged-gravel-driveway-finished.webp", "Gravel", "Norwich"],
        ["tar-and-chip/projects/north-walsham/north-walsham-tar-and-chip-driveway-wide-view.webp", "Tar & chip", "North Walsham"],
        ["resin/projects/kings-lynn-grey-marble/kings-lynn-grey-marble-resin-driveway-finished.webp", "Resin bound", "King's Lynn"],
        ["resin/projects/fakenham-charcoal/fakenham-charcoal-resin-driveway-finished.webp", "Resin bound", "Fakenham"]
      ] %}
      <figure class="lp-shot"><img src="/assets/images/{{ w[0] }}" alt="{{ w[1] }} driveway in {{ w[2] }}" loading="lazy" decoding="async"><figcaption><b>{{ w[1] }}</b> {{ w[2] }}</figcaption></figure>
      {% endfor %}
    </div>
  </section>

  {% if not hideSurfaces %}
  <section class="lp-sec lp-surf" aria-labelledby="surf-h">
    <div class="lp-wrap">
      <span class="lp-eyebrow">What we lay</span>
      <h2 id="surf-h" class="lp-h2">Pick your <em>finish.</em></h2>
      <p class="lp-lede">Tap one to start your quote. Not sure? We'll talk you through it at the site visit.</p>
      <div class="lp-surfs">
        {% for s in [
          ["Resin bound", "resin/projects/burnham-golden-harvest/burnham-golden-harvest-resin-driveway-finished.webp", "Smooth, porous and weed-free. The premium finish."],
          ["Block paving", "block-paving/projects/st-faiths/st-faiths-block-paving-driveway-finished.webp", "Classic patterns and borders, built to last decades."],
          ["Tarmac", "tarmac/projects/sheringham-grey/sheringham-grey-tarmac-driveway-angle.webp", "Hard-wearing, tidy and great value for bigger drives."],
          ["Tar & chip", "tar-and-chip/projects/the-old-hall/the-old-hall-tar-and-chip-driveway-closeup.webp", "A rustic, country look that suits Norfolk homes."],
          ["Gravel", "gravel/projects/bungalow-golden/bungalow-golden-gravel-driveway-finished.webp", "Quick to lay and easy on the budget, on a proper base."]
        ] %}
        <a class="lp-surf" href="#quote" data-pick="{{ s[0] }}">
          <img src="/assets/images/{{ s[1] }}" alt="" loading="lazy" decoding="async">
          <span class="lp-surf-t"><b>{{ s[0] }}</b><span>{{ s[2] }}</span></span>
          <svg class="lp-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="lp-sec lp-how" aria-labelledby="how-h">
    <div class="lp-wrap">
      <span class="lp-eyebrow">How it works</span>
      <h2 id="how-h" class="lp-h2">Three steps. <em>No pressure.</em></h2>
      <ol class="lp-steps">
        <li><span class="lp-n">01</span><b>We call you back</b><span>Within one working day, to understand the job and book a time.</span></li>
        <li><span class="lp-n">02</span><b>Free site visit</b><span>We come out, measure up and check the ground under your drive.</span></li>
        <li><span class="lp-n">03</span><b>Written quote</b><span>A clear, itemised price. No chasing, no hard sell.</span></li>
      </ol>
    </div>
  </section>

  <section class="lp-sec lp-quote" id="quote" aria-labelledby="quote-h">
    <div class="lp-wrap lp-quote-grid">
      <div class="lp-quote-intro">
        <span class="lp-eyebrow">Free, no obligation</span>
        <h2 id="quote-h" class="lp-h2">Get your free <em>quote.</em></h2>
        <p class="lp-lede">Takes about 30 seconds. We'll be in touch within one working day to book your site visit.</p>
        <p class="lp-or">Rather talk? <a href="{{ site.phoneHref }}" data-call>Call {{ site.phone }}</a></p>
      </div>

      <form class="lp-form" id="lpForm" novalidate>
        <input type="text" name="company" id="lpHp" tabindex="-1" autocomplete="off" aria-hidden="true" class="lp-hp">
        <fieldset class="lp-fs" id="lpSurf">
          <legend>Which surface? <span>(pick any)</span></legend>
          <div class="lp-chips">
            {% for s in ["Resin bound", "Block paving", "Tarmac", "Tar & chip", "Gravel", "Not sure yet"] %}
            <button type="button" class="lp-chip{% if loop.last %} any{% endif %}" data-val="{{ s }}" aria-pressed="false">{{ s }}</button>
            {% endfor %}
          </div>
        </fieldset>
        <fieldset class="lp-fs" id="lpTime">
          <legend>When? <span>(optional)</span></legend>
          <div class="lp-chips">
            {% for t in ["ASAP", "1–3 months", "Just researching"] %}
            <button type="button" class="lp-chip" data-val="{{ t }}" aria-pressed="false">{{ t }}</button>
            {% endfor %}
          </div>
        </fieldset>
        <div class="lp-fields">
          <label class="lp-f" id="lf-name"><span>Name</span><input name="name" type="text" autocomplete="name" placeholder="Your name"><i>Please add your name</i></label>
          <label class="lp-f" id="lf-phone"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" placeholder="07…"><i>Please add a phone number</i></label>
          <label class="lp-f" id="lf-pc"><span>Postcode</span><input name="postcode" type="text" autocomplete="postal-code" placeholder="NR…"><i>Please add your postcode</i></label>
          <label class="lp-f" id="lf-email"><span>Email</span><input name="email" type="email" autocomplete="email" placeholder="you@email.com"><i>Please check your email</i></label>
        </div>
        <button class="lp-btn lp-btn-gold lp-submit" type="submit">Get my free quote <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        <p class="lp-fine">No obligation. We only use your details to arrange your quote.</p>
        <p class="lp-err" id="lpErr" role="alert" hidden>Sorry, that didn't send. Please call <a href="{{ site.phoneHref }}">{{ site.phone }}</a> or email <a href="mailto:{{ site.email }}">{{ site.email }}</a> and we'll sort it straight away.</p>
      </form>
    </div>
  </section>

  <footer class="lp-foot">
    <div class="lp-wrap lp-foot-row">
      <span class="lp-logo"><span class="l1">Precision</span><span class="l2">Surfacing</span></span>
      <span class="lp-foot-areas">{{ site.locations }}</span>
      <span class="lp-foot-contact"><a href="{{ site.phoneHref }}" data-call>{{ site.phone }}</a> · <a href="mailto:{{ site.email }}">{{ site.email }}</a></span>
    </div>
  </footer>

  <div class="lp-sticky" id="lpSticky" aria-hidden="true">
    <a class="lp-btn lp-btn-ghost" href="{{ site.phoneHref }}" data-call tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg> Call</a>
    <a class="lp-btn lp-btn-gold" href="#quote" tabindex="-1">Free quote <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </div>
