---
layout: layouts/base.njk
title: "Gallery — Precision Surfacing"
description: "Recent driveway and surfacing projects across Norfolk — resin, tarmac, tar & chip, block paving and gravel."
---
<main class="gallery">
  <header class="gal-head" data-theme="dark">
    <div class="gal-head-in">
      <h1 class="gal-kick">Our work</h1>
      <p>A selection of driveways and surfaces we've laid across Norfolk — tap any photo to see it full-size.</p>
    </div>
  </header>

  <div class="gal-body" data-theme="dark">
    {# One tile per project — click it to page through that project's photos.
       Built from galleryProjects.js, which reads the same data as the service pages. #}
    <div class="gal-grid" id="galGrid">
      {%- for proj in galleryProjects %}
      <button class="gal" type="button" data-cat="{{ proj.cat }}" data-proj="{{ loop.index0 }}" aria-label="View {{ proj.images | length }} photos from {{ proj.title }}, {{ proj.place }}"><img src="{{ proj.images[0] }}" alt="{{ proj.surface }} {{ proj.title | lower }} in {{ proj.place }}" loading="lazy" decoding="async"><span class="gal-cap"><b>{{ proj.place }}</b><i>{{ proj.surface }}</i></span><span class="gal-count">{{ proj.images | length }} photos</span></button>
      {%- endfor %}
    </div>

    <script type="application/json" id="galData">{{ galleryProjects | dump | safe }}</script>

    <div class="gal-cta">
      <h2>Like what you <em>see?</em></h2>
      <p>Every one of these started with a free site visit and an honest quote. Yours can too.</p>
      <a class="start-go" href="/get-a-quote/">Start your free quote <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>

  <!-- lightbox -->
  <div class="glb" id="glb" aria-hidden="true">
    <button class="glb-x" id="glbX" type="button" aria-label="Close">Close ✕</button>
    <div class="glb-stage">
      <button class="glb-arrow prev" id="glbPrev" type="button" aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></button>
      <figure class="glb-fig"><img id="glbImg" src="" alt=""></figure>
      <button class="glb-arrow next" id="glbNext" type="button" aria-label="Next"><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
    <figcaption class="glb-cap" id="glbCap"></figcaption>
    <div class="glb-count" id="glbCount"></div>
  </div>
</main>

<style>
  .gallery{background:var(--ink,#0E0F10)}
  /* ---- header ---- */
  .gal-head{background:transparent;color:#fff;padding:74px 0 30px}
  .gal-head-in{padding-inline:var(--pad,26px)}
  .gal-head .kicker{color:var(--gold)}
  .gal-kick{display:flex;align-items:center;gap:14px;font-family:var(--font-logo,"Raleway",sans-serif);
    font-weight:600;font-size:13px;letter-spacing:.3em;text-transform:uppercase;color:#fff;margin:0 0 16px}
  .gal-kick::after{content:"";flex:1;height:1px;background:rgba(255,255,255,.18)}
  .gal-head p{color:rgba(255,255,255,.62);max-width:52ch;font-size:16px}
  /* ---- body ---- */
  .gal-body{padding:26px var(--pad,26px) 90px}
  /* filter chips */
  .gal-filter{display:flex;flex-wrap:wrap;gap:9px;padding:8px 6px 22px}
  .fbtn{font-family:var(--mono,"Raleway",sans-serif);font-size:11px;letter-spacing:.12em;text-transform:uppercase;
    color:rgba(255,255,255,.72);background:transparent;border:1px solid rgba(255,255,255,.22);border-radius:30px;
    padding:9px 15px;cursor:pointer;transition:background .18s ease,color .18s ease,border-color .18s ease}
  .fbtn:hover{border-color:rgba(255,255,255,.5);color:#fff}
  .fbtn.is-on{background:var(--gold-hl,#F0CC3A);border-color:var(--gold-hl,#F0CC3A);color:var(--ink,#0E0F10);font-weight:600}
  /* masonry grid */
  .gal-grid{columns:1;column-gap:14px}
  .gal{break-inside:avoid;display:block;width:100%;margin:0 0 14px;padding:0;border:0;background:#1c1c1d;
    border-radius:6px;overflow:hidden;position:relative;cursor:pointer;line-height:0;
    box-shadow:0 1px 2px rgba(14,15,16,.05);transition:transform .3s cubic-bezier(.22,1,.36,1),box-shadow .3s ease}
  .gal.hide{display:none}
  .gal img{width:100%;height:auto;display:block;transition:transform .5s cubic-bezier(.22,1,.36,1)}
  .gal-cap{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;gap:2px;
    padding:34px 14px 12px;text-align:left;line-height:1.3;
    background:linear-gradient(to top,rgba(8,9,10,.82),rgba(8,9,10,0));
    opacity:0;transform:translateY(6px);transition:opacity .3s ease,transform .3s ease}
  .gal-count{position:absolute;top:10px;right:10px;font-family:var(--font-logo,"Raleway",sans-serif);
    font-weight:600;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#fff;
    background:rgba(8,9,10,.6);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);
    padding:5px 9px;border-radius:3px;line-height:1;pointer-events:none}
  .gal-cap b{font-family:var(--font-logo,"Raleway",sans-serif);font-weight:600;font-size:13px;letter-spacing:.06em;color:#fff}
  .gal-cap i{font-family:var(--mono,"Raleway",sans-serif);font-style:normal;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-hl,#F0CC3A)}
  .gal:hover{transform:translateY(-3px);box-shadow:0 16px 34px -14px rgba(14,15,16,.45)}
  .gal:hover img{transform:scale(1.05)}
  .gal:hover .gal-cap,.gal:focus-visible .gal-cap{opacity:1;transform:none}
  .gal-empty{padding:30px 6px;color:var(--mist,#7E817A);font-size:15px}
  .gal-empty a{color:var(--gold-deep)}
  /* ---- closing cta ---- */
  .glb-count{position:absolute;left:0;right:0;bottom:16px;text-align:center;font-family:var(--font-logo,"Raleway",sans-serif);
    font-weight:600;font-size:11px;letter-spacing:.2em;color:rgba(255,255,255,.5)}
  .gal-cta{text-align:center;padding:64px 20px 8px;margin-top:20px;border-top:1px solid rgba(255,255,255,.12)}
  .gal-cta h2{font-family:var(--serif,"Instrument Serif",serif);font-weight:400;font-size:clamp(30px,7vw,42px);color:#fff;margin-bottom:10px}
  .gal-cta h2 em{font-style:italic;color:var(--gold-hl)}
  .gal-cta p{color:rgba(255,255,255,.66);font-size:15.5px;line-height:1.6;max-width:42ch;margin:0 auto 26px}
  .gal-cta .start-go{display:inline-flex;align-items:center;gap:10px;background:var(--gold-hl);color:var(--ink);text-decoration:none;font-family:var(--mono,"Raleway",sans-serif);font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:16px 26px;border-radius:8px;transition:background .2s ease,transform .12s ease}
  .gal-cta .start-go svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.9}
  .gal-cta .start-go:hover{background:#F4D44A}
  .gal-cta .start-go:active{transform:scale(.98)}
  /* ---- lightbox ---- */
  .glb{position:fixed;inset:0;z-index:80;background:rgba(8,8,9,.96);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);
    display:flex;flex-direction:column;opacity:0;visibility:hidden;transition:opacity .3s ease,visibility .3s ease}
  .glb.on{opacity:1;visibility:visible}
  .glb-x{align-self:flex-end;margin:18px 20px 0;background:none;border:0;cursor:pointer;color:rgba(255,255,255,.6);font-family:var(--mono,"Raleway",sans-serif);font-size:12px;letter-spacing:.14em}
  .glb-x:hover{color:var(--gold-hl)}
  /* The arrows sit ON the photo rather than beside it — as flex siblings they were
     pushed off a phone screen entirely, because the photo already took 92vw. */
  .glb-stage{position:relative;flex:1;display:flex;align-items:center;justify-content:center;min-height:0;padding:6px 8px}
  .glb-fig{margin:0;max-width:92vw;max-height:78vh;display:flex}
  .glb-fig img{max-width:92vw;max-height:78vh;width:auto;height:auto;object-fit:contain;border-radius:4px;display:block}
  .glb-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:2;background:rgba(8,9,10,.5);
    -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);border:0;border-radius:50%;
    width:44px;height:44px;display:flex;align-items:center;justify-content:center;padding:0;cursor:pointer;
    transition:background .2s ease}
  .glb-arrow.prev{left:10px}
  .glb-arrow.next{right:10px}
  .glb-arrow:hover{background:rgba(8,9,10,.78)}
  .glb-arrow svg{width:26px;height:26px;stroke:#fff;fill:none;stroke-width:2;filter:drop-shadow(0 1px 4px rgba(0,0,0,.7));display:block;transition:stroke .2s ease}
  .glb-arrow:hover svg{stroke:var(--gold-hl)}
  .glb-cap{text-align:center;padding:14px 20px 26px;font-family:var(--mono,"Raleway",sans-serif);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.7)}

  @media (min-width:680px){ .gal-grid{columns:2;column-gap:18px} .gal{margin-bottom:18px} }
  @media (min-width:1040px){ .gal-grid{columns:3;column-gap:20px} }
  @media (min-width:760px){
    .gal-head{padding:108px 0 44px}
    .gal-head-in{padding-inline:max(50px,calc((100% - 1120px) / 2))}
    .gal-body{padding:30px max(50px,calc((100% - 1120px) / 2)) 110px}
    .glb-x{margin:22px clamp(28px,4vw,56px) 0}
    .glb-arrow{width:52px;height:52px}
    .glb-arrow.prev{left:clamp(12px,3vw,40px)}
    .glb-arrow.next{right:clamp(12px,3vw,40px)}
    .glb-arrow svg{width:30px;height:30px}
  }
</style>

<script>
  (function(){
    var grid=document.getElementById('galGrid'); if(!grid) return;
    var tiles=[].slice.call(grid.querySelectorAll('.gal'));
    var fbtns=[].slice.call(document.querySelectorAll('.fbtn'));
    var empty=document.getElementById('galEmpty');
    var projects=[];
    try { projects=JSON.parse(document.getElementById('galData').textContent); } catch(e){}

    function apply(f){
      fbtns.forEach(function(b){b.classList.toggle('is-on', b.dataset.filter===f);});
      var shown=0;
      tiles.forEach(function(t){ var hide = f!=='all' && t.dataset.cat!==f; t.classList.toggle('hide',hide); if(!hide)shown++; });
      if(empty) empty.hidden = shown>0;
    }
    fbtns.forEach(function(b){ b.addEventListener('click',function(){ apply(b.dataset.filter); }); });

    /* Lightbox pages through ONE project's photos, not the whole gallery. */
    var glb=document.getElementById('glb'), gimg=document.getElementById('glbImg');
    var gcap=document.getElementById('glbCap'), gcount=document.getElementById('glbCount');
    var prev=document.getElementById('glbPrev'), next=document.getElementById('glbNext');
    var proj=null, i=0;
    var cache={};
    function preload(src){ if(!cache[src]){ var im=new Image(); im.decoding='async'; im.src=src; cache[src]=im; } }
    function pad(n){ return (n<10?'0':'')+n; }
    function paint(){
      if(!proj) return;
      gimg.src=proj.images[i];
      gimg.alt=proj.surface+' '+(proj.title||'').toLowerCase()+' in '+proj.place;
      gcap.textContent=proj.surface+' · '+proj.place;
      gcount.textContent=proj.images.length>1 ? pad(i+1)+' / '+pad(proj.images.length) : '';
      var multi=proj.images.length>1;
      prev.style.display=multi?'':'none';
      next.style.display=multi?'':'none';
      preload(proj.images[(i+1)%proj.images.length]);
      preload(proj.images[(i-1+proj.images.length)%proj.images.length]);
    }
    function open(n){
      proj=projects[n]; if(!proj||!proj.images.length) return;
      i=0; paint();
      proj.images.forEach(preload);                      // the rest arrive while you look at the first
      glb.classList.add('on'); glb.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden';
    }
    function close(){ glb.classList.remove('on'); glb.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }
    function step(d){ if(!proj) return; i=(i+d+proj.images.length)%proj.images.length; paint(); }

    tiles.forEach(function(t){ t.addEventListener('click',function(){ open(+t.dataset.proj); }); });
    document.getElementById('glbX').addEventListener('click',close);
    prev.addEventListener('click',function(e){ e.stopPropagation(); step(-1); });
    next.addEventListener('click',function(e){ e.stopPropagation(); step(1); });
    glb.addEventListener('click',function(e){ if(!e.target.closest('.glb-fig') && !e.target.closest('button')) close(); });
    document.addEventListener('keydown',function(e){ if(!glb.classList.contains('on')) return; if(e.key==='Escape')close(); if(e.key==='ArrowLeft')step(-1); if(e.key==='ArrowRight')step(1); });
    var tx=0;
    glb.addEventListener('touchstart',function(e){ tx=e.changedTouches[0].clientX; },{passive:true});
    glb.addEventListener('touchend',function(e){ var dx=e.changedTouches[0].clientX-tx; if(Math.abs(dx)>45) step(dx<0?1:-1); },{passive:true});
  })();
</script>
